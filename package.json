{
  "name": "shellport",
  "productName": "Shellport",
  "version": "0.3.1",
  "description": "A tabbed SSH/SFTP client for Windows, inspired by MobaXterm",
  "author": "Simon Vesterlund",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:backend": "node --experimental-transform-types --no-warnings scripts/backend-test.ts",
    "dist:win": "electron-vite build && electron-builder --win nsis --x64 --publish never",
    "test:unit": "node --experimental-transform-types --no-warnings scripts/unit-test.ts"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
