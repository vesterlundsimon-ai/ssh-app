{
  "name": "simssh",
  "productName": "SimSSH",
  "version": "0.5.0",
  "description": "A tabbed SSH/SFTP client for Windows, inspired by MobaXterm",
  "author": "Simon Vesterlund",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run -s patch:ssh2 && electron-vite dev",
    "build": "npm run -s patch:ssh2 && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:backend": "npm run -s patch:ssh2 && node --experimental-transform-types --no-warnings scripts/backend-test.ts",
    "dist:win": "npm run -s build && electron-builder --win nsis --x64 --publish never",
    "test:unit": "npm run -s patch:ssh2 && node --experimental-transform-types --no-warnings scripts/unit-test.ts",
    "patch:ssh2": "node scripts/patch-ssh2.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
